{
  "name": "forex-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:admin": "npm --workspace apps/admin run dev",
    "db:migrate": "npm --workspace apps/api run migrate",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "lucide-react": "^1.68.0"
  }
}
