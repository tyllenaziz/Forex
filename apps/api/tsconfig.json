{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "baseUrl": ".",
    "rootDir": "../..",
    "paths": {
      "@platform/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@platform/money": ["../../packages/money/src/index.ts"]
    },
    "composite": true,
    "incremental": true
  },
  "include": ["src", "../../packages/shared-types/src", "../../packages/money/src"]
}